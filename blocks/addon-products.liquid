{%- doc -%}
  Renders product recommendations.
  {section.id} - identifies the parent section for the Section Rendering API

  https://shopify.dev/docs/api/section-rendering-api
{%- enddoc -%}

{% liquid
  assign addon_products = product.metafields.shopify--discovery--product_recommendation.complementary_products.value

  if addon_products == blank
    break
  endif

  assign block_settings = block.settings
  case block_settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list--carousel'
  endcase

  assign is_frequent_bundle = false
  if block_settings.card_layout_type == 'card-layout-addon-frequently'
    assign is_frequent_bundle = true
  endif
%}

{%- comment -%}
  v4 moved .resource-list--grid column CSS out of base.css into this opt-in snippet.
  Render it so the grid never collapses to 1 column when no product-list is on the page.
  {% stylesheet %} blocks dedupe, so this is safe.
{%- endcomment -%}
{% render 'resource-list-styles' %}

{% comment %}
  [data-section-id] {section.id} - used to fetch the product recommendations from the Section Rendering API
{% endcomment %}

<addon-products
  id="addon-products-{{ block.id }}"
  class="addon-products"
  data-section-id="{{ section.id }}"
  data-product-id="{{ closest.product.id }}"
  {% if is_frequent_bundle %}
    data-standalone
  {% endif %}
  {% if request.visual_preview_mode %}
    data-shopify-editor-preview
  {% endif %}
  data-testid="addon-products-block"
  {{ block.shopify_attributes }}
>
  {% if block_settings.background_color != blank %}{% render 'contrast-override', background_color: block_settings.background_color, section_id: block.id %}{% endif %}
  <div
    class="
      {% if block_settings.background_color != blank %}color-custom-{{ block.id }}{% endif %}
      block-resource-list
      spacing-style
      gap-style
      border-style
    "
    style="
      {%  render 'spacing-style', settings: block_settings %}
      {%  render 'gap-style', value: block_settings.gap %}
      {% render 'border-override', settings: block_settings %}
      --resource-list-column-gap-desktop: {{ block_settings.columns_gap }}px;
      --resource-list-row-gap-desktop: {{ block_settings.rows_gap }}px;
      --resource-list-columns-mobile: 1fr;
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {%- if addon_products -%}
      {% liquid
        assign products = addon_products
      %}

      {% capture list_items %}
        {% for product in products limit: block_settings.max_products %}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_addon-card',
              id: 'static-addon-card',
              card_layout_type: block_settings.card_layout_type,
              standalone: is_frequent_bundle,
              closest.product: product
            %}
          </div>
          {% if block_settings.layout_type == 'carousel' or block_settings.carousel_on_mobile %}
            {% unless forloop.last %}
              <!--@list/split-->
            {% endunless %}
          {% endif %}
        {% endfor %}
      {% endcapture %}

      {% liquid
        # Create an array from the list items to be used in the carousel
        assign slide_content = list_items | strip
        assign slides = slide_content | split: '<!--@list/split-->'
      %}

      <div
        class="
          resource-list
          {% if block_settings.layout_type == 'grid' and block_settings.card_layout_type == 'card-layout-addon-frequently' %}
            resource-list--frequent-bundle
          {% endif %}
          {% if block_settings.carousel_on_mobile and block_settings.layout_type != 'carousel' %}
            hidden--mobile
          {% endif %}
          {{ classes }}
        "
        {% if block_settings.layout_type == 'grid' %}
          data-testid="resource-list-grid"
        {% endif %}
      >
        {% case block_settings.layout_type %}
          {% when 'grid' %}
            {% if is_frequent_bundle %}
              <div class="frequent-bundle" data-frequent-bundle>
                {% render 'frequent-bundle-strip',
                  products: products,
                  limit: block_settings.max_products,
                  host_id: block.id
                %}
                <div class="total-frequent-price addon-bundle__footer" hidden>
                  <span class="addon-bundle__total">
                    <span class="addon-bundle__total-label">{{ 'content.total' | t }}</span>
                    <span class="addon-bundle-total">
                      <span class="total-price-display__inner">
                        <s class="compare-at-price total-price-display__at" hidden></s>
                        <span class="price total-price-display__sale"></span>
                      </span>
                    </span>
                  </span>
                  <button type="button" class="button frequent-add-to-cart addon-bundle__atc">
                    <span class="add-to-cart-text">
                      <span class="add-to-cart-text__content">
                        <span>
                          <span>{{- 'content.add_selected_to_cart' | t -}}</span>
                        </span>
                      </span>
                    </span>
                    <span class="add-to-cart__added">
                      <span class="svg-wrapper add-to-cart__added-icon">
                        {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                      </span>
                    </span>
                  </button>
                </div>
                <div
                  class="frequent-bundle__details"
                  id="frequent-details-panel-{{ block.id }}"
                >
                  <div class="frequent-bundle__details-list">
                    {{ list_items }}
                  </div>
                </div>
              </div>
            {% else %}
              {{ list_items }}
            {% endif %}
          {% when 'carousel' %}
            {% render 'resource-list-carousel',
              ref: 'resourceListCarousel',
              slides: slides,
              slide_count: products.size,
              settings: block_settings
            %}
        {% endcase %}
      </div>

      {% if block_settings.carousel_on_mobile and block_settings.layout_type != 'carousel' %}
        {% liquid
          assign mobile_carousel_gap = block_settings.columns_gap
        %}
        <div
          class="
            resource-list
            hidden--desktop
            force-full-width
          "
          style="--resource-list-gap: {{ mobile_carousel_gap }}px;"
        >
          {% render 'resource-list-carousel',
            ref: 'resourceListCarouselMobile',
            slides: slides,
            slide_count: products.size,
            settings: block_settings
          %}
        </div>
      {% endif %}
    {%- endif -%}
  </div>
</addon-products>

{% stylesheet %}
  .block-resource-list {
    display: flex;
    flex-direction: column;
    row-gap: var(--gap);
    min-width: 0;
    min-height: 0;
    container-type: inline-size;
    container-name: resource-list;
    border-radius: var(--border-radius, 0);
  }

  .addon-products-wrapper {
    width: 100%;
  }

  .addon-products-wrapper:empty {
    display: none;
  }

  .addon-products-wrapper:has(addon-products[data-shopify-editor-preview]) {
    width: 100vw;
  }

  /* Standalone frequently-bought bundle — all rules scoped to .addon-products (the block);
     the frequently-bought SECTION (.frequently-bought-section) keeps its own look. */

  /* Strip is a horizontal slider bounded by the block, like Horizon's resource-list carousels:
     cells keep a fixed size and overflow scrolls instead of spilling past the parent's edge. */
  .addon-products .frequent-bundle__strip {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    min-width: 0;
    padding-block-end: var(--padding-2xs);

    /* Run to the block's edges: cancel its inline padding with negative margins (the block
       exposes them as --padding-inline-*), then pad the scroll ends back so the first and
       last cell still clear the edge when parked. */
    width: auto;
    max-width: none;
    margin-inline-start: calc(-1 * var(--padding-inline-start, 0px));
    margin-inline-end: calc(-1 * var(--padding-inline-end, 0px));
    padding-inline-start: var(--padding-inline-start, 0px);
    padding-inline-end: var(--padding-inline-end, 0px);
    scroll-padding-inline-start: var(--padding-inline-start, 0px);
  }

  .addon-products .frequent-bundle__strip::-webkit-scrollbar {
    display: none;
  }

  .addon-products .frequent-strip__cell-wrap {
    flex: 0 0 auto;
    width: auto;
    max-width: none;
    scroll-snap-align: start;
  }

  .addon-products .frequent-bundle__details .addon-card .addon-flex {
    align-items: flex-start;
  }

  /* Smaller "+" between cells; the shared 3xl size crowds these compact thumbs. */
  .addon-products .frequent-strip__cell-wrap:not(:last-child)::after {
    font-size: var(--font-size--lg);
  }

  @media screen and (min-width: 750px) {
    /* Desktop keeps a fixed 4-up grid: cells shrink to fit rather than scrolling. */
    .addon-products .frequent-bundle__strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--gap);
      row-gap: var(--gap);
      overflow-x: visible;
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
      padding-inline: 0;
    }

    .addon-products .frequent-strip__cell-wrap {
      flex: initial;
      width: auto;
      min-width: 0;
    }

    /* A row-end "+" would sit in the gap outside the grid, so drop it on every 4th cell. */
    .addon-products .frequent-strip__cell-wrap:nth-child(4n)::after {
      content: none;
    }

    .addon-products .frequent-strip__img,
    .addon-products .frequent-strip__placeholder {
      width: 100%;
      max-width: 72px;
    }

    .addon-products .frequent-strip__shell {
      --checkbox-size: 16px;
    }

    .addon-products .frequent-strip__shell .checkbox__label.frequent-strip__thumb {
      gap: var(--gap-xs);
    }
  }

  /* Strip thumbs: let the image shrink inside its box instead of overflowing past the
     checkbox (base rule pins flex-shrink: 0, which pushes 72px images out of narrow cells). */
  .addon-products .frequent-strip__img,
  .addon-products .frequent-strip__placeholder {
    flex: 0 1 auto;
    min-width: 0;
    width: 72px;
    max-width: 72px;
  }

  /* Cells stay visually flat when checked; the checkbox alone signals selection. */
  .addon-products .frequent-strip__cell-wrap:has(.checkbox__input:checked) {
    border-color: rgb(var(--color-foreground-rgb) / 1);
    box-shadow: none;
  }

  /* Details rows: the strip on top already shows each product image; drop the row thumbnails. */
  .addon-products .frequent-bundle__details .addon-image-wrapper {
    display: none;
  }

  /* Compact checkboxes for the details rows of this block only. */
  .addon-products .frequent-bundle__details .addon-card {
    --checkbox-size: 14px;
    --checkbox-border-radius: 3px;
  }

  .addon-products .frequent-bundle__details .addon-card .checkbox__label {
    min-width: auto;
  }

  /* Title and price sit inline on one row; variant select and sold-out note wrap below. */
  .addon-products .frequent-bundle__details .addon-flex > div:last-child {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: var(--gap-sm);
  }

  /* The title link is `display: contents`, so its inner text-block is the real flex item. The
     price sits inside a product-card-group wrapper carrying --size-style-width: 100%, which
     would claim the whole line; size both to their content instead. */
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > .contents > .text-block,
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > .contents > .text-block > *,
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > .product-card-group,
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > product-price {
    width: auto;
  }

  /* flex-basis 0, not auto: a wrapping flex line is laid out from each item's UNSHRUNK base
     size, so a long title would claim the whole line and push the price onto the next one
     before any shrinking happens. Zero basis keeps title and price on one line. */
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > .contents > .text-block {
    flex: 1 1 0;
    min-width: 0;
  }

  .addon-products .frequent-bundle__details .addon-flex > div:last-child > .product-card-group,
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > product-price {
    flex: 0 0 auto;
    text-align: right;
  }

  /* Titles wrap in full; keeping title and price on one row matters more than one-line titles. */
  .addon-products .frequent-bundle__details .addon-flex > div:last-child > .contents > .text-block > * {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }

  /* Flat list: no divider between rows. */
  .addon-products .frequent-bundle__details-list > .resource-list__item {
    border-block-end: none;
  }

  .addon-products .frequent-bundle__details .addon-variant-wrapper,
  .addon-products .frequent-bundle__details .sold-out-addon {
    flex: 1 0 100%;
  }

  /* Footer: total + own add-to-cart, bottom right of the always-visible details list. */
  .addon-products .total-frequent-price.addon-bundle__footer {
    width: 100%;
    max-width: none;
  }

  .addon-products .total-frequent-price.addon-bundle__footer:not([hidden]) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap-xs);
  }

  .addon-bundle__total {
    display: inline-flex;
    align-items: baseline;
    gap: var(--gap-2xs);
    font-size: var(--font-size--md);
  }

  .addon-bundle__total-label {
    font-size: var(--font-size--sm);
  }

  .addon-bundle__total-label,
  .addon-products .addon-bundle-total {
    font-weight: bold;
  }

  .addon-products .frequent-add-to-cart.addon-bundle__atc {
    position: relative;
    width: fit-content;
    min-height: auto;
    padding-block: calc(var(--padding-xs) * 1.1);
    padding-inline: calc(var(--padding-lg) * 1.1);
    font-size: calc(var(--font-size--sm) * 1.1);
    font-weight: var(--font-body--weight);
  }

  /* Added + in-progress states reuse Horizon's add-to-cart animation (the slide keyframes and
     .checkmark-burst base styles ship with the main buy button); only sizing is scoped here. */
  .addon-products .addon-bundle__atc .add-to-cart__added-icon {
    width: var(--icon-size-lg);
    height: var(--icon-size-lg);
  }

  .addon-products .addon-bundle__atc[data-added='true'] {
    color: transparent;
  }

  .addon-products .addon-bundle__atc[data-added='true'] .checkmark-burst {
    opacity: 1;
  }

  .addon-products .addon-bundle__atc[data-loading='true'] {
    opacity: var(--opacity-60);
    pointer-events: none;
    cursor: progress;
  }

  @media screen and (max-width: 749px) {
    /* The shared mobile rule wraps cells into a 3-up grid, which pushes the row-end "+" (offset
       into the gap) past the block's edge. Stay a single nowrap scrolling row instead. */
    .addon-products .frequent-bundle__strip {
      --gap: 24px;
      display: flex;
      grid-template-columns: none;
    }

    /* Narrow rows: stack title over price and let the title wrap in full. */
    .addon-products .frequent-bundle__details .addon-flex > div:last-child {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .addon-products .frequent-bundle__details .addon-flex > div:last-child > .product-card-group,
    .addon-products .frequent-bundle__details .addon-flex > div:last-child > product-price {
      text-align: left;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "Addon Products",
  "class": "addon-products-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "card_layout_type",
      "label": "Card layout type",
      "options": [
        {
          "value": "card-layout-addon",
          "label": "Product addons"
        },
        {
          "value": "card-layout-addon-frequently",
          "label": "Frequently bought"
        }
      ],
      "default": "card-layout-addon"
    },
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_recommendations"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_style",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' or block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.icons_style != 'none' and block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_radius",
      "label": "Custom mobile radius",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "label": "Mobile corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.enable_mobile_radius == true }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Addon Products",
      "category": "t:categories.product",
      "settings": {
        "border_radius": 0,
        "padding-inline-start": 0,
        "padding-inline-end": 0
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "t:html_defaults.may_also_like"
          }
        },
        "static-addon-card": {
          "type": "_addon-card",
          "static": true,
          "settings": {
            "product_card_gap": 4
          },
          "blocks": {
            "product_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
